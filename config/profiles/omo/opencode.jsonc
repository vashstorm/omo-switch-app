{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    // "superpowers@git+https://github.com/obra/superpowers.git",
    "oh-my-opencode@latest",
    "@mohak34/opencode-notifier@latest"
  ],
  "provider": {
    "aigo-claudex": {
      "models": {
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      },
      "name": "AIGoCode",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "apiKey": "${AIGO_API_KEY}",
        "baseURL": "https://api.aigocode.com/v1"
      }
    },
    "aigo-codexx": {
      "models": {
        "gpt-5.3-codex": {
          "name": "gpt-5.3-codex",
          "limit": {
            "context": 400000,
            "output": 131072
          }
        },
        "gpt-5.4": {
          "name": "gpt-5.4",
          "limit": {
            "context": 1050000,
            "output": 131072
          }
        }
      },
      "name": "AIGoCode",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "${AIGO_API_KEY}",
        "baseURL": "https://api.aigocode.com/v1"
      }
    },
    "aigo-geminix": {
      "models": {
        "gemini-3-flash-preview": {
          "name": "gemini-3-flash-preview",
          "limit": {
            "context": 1048576,
            "output": 67072
          }
        },
        "gemini-3.1-pro-preview": {
          "name": "gemini-3.1-pro-preview",
          "limit": {
            "context": 1048576,
            "output": 67072
          }
        }
      },
      "name": "AIGoCode",
      "npm": "@ai-sdk/google",
      "options": {
        "apiKey": "${AIGO_GEMINI_API_KEY}",
        "baseURL": "https://api.aigocode.com/v1beta"
      }
    },
    "cubence-claude": {
      "models": {
        "claude-sonnet-4-6": {
          "name": "claude-sonnet-4-6",
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      },
      "name": "Cubence",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "apiKey": "${CUBENCE_API_KEY}",
        "baseURL": "https://api.cubence.com/v1"
      }
    },
    "cubence-gpt": {
      "models": {
        "gpt-5.3-codex": {
          "name": "gpt-5.3-codex",
          "limit": {
            "context": 400000,
            "output": 131072
          }
        },
        "gpt-5.4": {
          "name": "gpt-5.4",
          "limit": {
            "context": 1050000,
            "output": 131072
          }
        }
      },
      "name": "Cubence",
      "npm": "@ai-sdk/openai",
      "options": {
        "apiKey": "${CUBENCE_API_KEY}",
        "baseURL": "https://api.cubence.com/v1"
      }
    }
  }
}
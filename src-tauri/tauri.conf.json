{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "omo-switch",
  "version": "0.1.0",
  "identifier": "com.omo-switch",
  "build": {
    "beforeDevCommand": "bun run build:web:assets && bun run dev:server -p 3000",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build:web:assets",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "title": "OMO Switch",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  },
  "plugins": {
    "opener": {}
  }
}
